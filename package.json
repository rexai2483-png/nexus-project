{
  "name": "nexus",
  "productName": "NEXUS",
  "version": "0.1.0",
  "description": "NEXUS — AI Computer Operator desktop application foundation",
  "private": true,
  "author": "NEXUS",
  "license": "UNLICENSED",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON,TSC,AGENT-TSC --prefix-colors \"cyan,magenta,yellow,green\" \"npm:dev:renderer\" \"npm:dev:electron\" \"npm:dev:electron:watch\" \"npm:dev:agent:watch\"",
    "dev:renderer": "vite",
    "dev:electron:watch": "tsc -p electron/tsconfig.json --watch --preserveWatchOutput",
    "dev:agent:watch": "tsc -p agent/tsconfig.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:5173 dist-electron/electron/main.js && cross-env NODE_ENV=development electron .",
    "build": "npm run build:renderer && npm run build:electron && npm run build:agent",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:agent": "tsc -p agent/tsconfig.json",
    "start": "cross-env NODE_ENV=production electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit && tsc -p agent/tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@libsql/client": "0.18.0",
    "@nut-tree-fork/nut-js": "4.2.6",
    "@prisma/adapter-libsql": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "electron": "45.2.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wait-on": "9.5.1"
  }
}
