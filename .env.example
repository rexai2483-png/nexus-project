# Copy this file to `.env` for local development.
# Never commit your real `.env` — it's gitignored. Nothing in this file
# is ever sent to the React renderer; only the Electron main process /
# backend reads it (see backend/ai/providerFactory.ts).

# SQLite connection string used by Prisma. Path is relative to this
# project's root. `npm run prisma:migrate` creates this file.
DATABASE_URL="file:./prisma/dev.db"

# "development" enables the Vite dev server + devtools in electron/main.ts.
# Leave unset (or "production") for production builds.
NODE_ENV=development

# --- AI provider (conversation + task planning) -----------------------
# NEXUS talks to exactly one configured cloud AI provider at a time.
# Without a key set here, NEXUS still runs — the dashboard, database, and
# conversation UI all work — but sending a chat message returns a clear
# "AI not configured" error instead of a reply.

# Which provider adapter to use. Currently only "anthropic" is implemented
# (backend/ai/providers/anthropic.ts); additional providers plug into the
# same backend/ai/types.ts#AiProvider interface.
AI_PROVIDER=anthropic

# Required for AI_PROVIDER=anthropic. Get a key at https://console.anthropic.com/
# Never shared with the renderer and never stored in the database.
ANTHROPIC_API_KEY=

# Model id to use. Defaults to "claude-sonnet-5" if unset — check your
# provider's current model list and override here if that id changes.
AI_MODEL=claude-sonnet-5
