// NEXUS — Prisma schema
//
// Local-only persistence for the desktop app. SQLite has no native enum
// type, so fields that are conceptually enums are modeled as `String`
// with a documented set of allowed values. The canonical list of values
// for each one lives in shared/types/models.ts — keep the two in sync.
//
// This schema intentionally holds no secrets or API keys. Credentials
// belong in the OS keychain / local env config, never in a DB row.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 moved connection URLs out of the schema file. The actual
// SQLite file used by `prisma migrate` / `prisma studio` is configured
// in prisma.config.ts (from DATABASE_URL). The running app instantiates
// PrismaClient with an explicit driver adapter — see backend/db/client.ts.
datasource db {
  provider = "sqlite"
}

/// Local application settings. Singleton-ish: the app always reads/writes
/// a single row (id = "default").
model UserSettings {
  id              String   @id @default("default")
  /// "dark" | "light" | "system"
  theme           String   @default("dark")
  launchOnStartup Boolean  @default(false)
  telemetryEnabled Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// A conversation thread between the user and NEXUS.
model Conversation {
  id        String    @id @default(cuid())
  title     String    @default("New conversation")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([updatedAt])
}

/// A single message within a conversation.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// "USER" | "ASSISTANT" | "SYSTEM"
  role           String
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

/// A unit of work the user has asked NEXUS to carry out. Execution is not
/// implemented yet in this foundation — tasks only model structure.
model Task {
  id             String       @id @default(cuid())
  title          String
  description    String?
  /// "PENDING" | "RUNNING" | "PAUSED" | "COMPLETED" | "FAILED" | "CANCELLED"
  status         String       @default("PENDING")
  agentSessionId String?
  agentSession   AgentSession? @relation(fields: [agentSessionId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  steps             TaskStep[]
  executionLogs     ExecutionLog[]
  approvalRequests  ApprovalRequest[]

  @@index([status])
  @@index([createdAt])
}

/// A single ordered step within a Task's plan.
model TaskStep {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  order       Int
  description String
  /// "PENDING" | "RUNNING" | "COMPLETED" | "FAILED" | "SKIPPED"
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  executionLogs    ExecutionLog[]
  approvalRequests ApprovalRequest[]

  @@unique([taskId, order])
  @@index([taskId])
}

/// An append-only log line produced while a task (or step) runs.
model ExecutionLog {
  id         String    @id @default(cuid())
  taskId     String?
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskStepId String?
  taskStep   TaskStep? @relation(fields: [taskStepId], references: [id], onDelete: Cascade)
  /// "DEBUG" | "INFO" | "WARN" | "ERROR"
  level      String    @default("INFO")
  message    String
  createdAt  DateTime  @default(now())

  @@index([taskId, createdAt])
  @@index([taskStepId, createdAt])
}

/// A human-in-the-loop approval gate before NEXUS may proceed with a
/// sensitive action. Nothing executes automatically without this record
/// being resolved.
model ApprovalRequest {
  id          String    @id @default(cuid())
  taskId      String?
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskStepId  String?
  taskStep    TaskStep? @relation(fields: [taskStepId], references: [id], onDelete: Cascade)
  title       String
  description String
  /// "PENDING" | "APPROVED" | "DENIED" | "EXPIRED"
  status      String    @default("PENDING")
  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([status])
}

/// A piece of durable context NEXUS has learned about the user or
/// environment. Not populated by this foundation — structure only.
model MemoryRecord {
  id        String   @id @default(cuid())
  /// "FACT" | "PREFERENCE" | "CONTEXT" | "SKILL"
  type      String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, key])
}

/// A single run of the agent loop (not implemented yet). Tasks may be
/// attributed to the session that created them.
model AgentSession {
  id        String    @id @default(cuid())
  /// "ACTIVE" | "IDLE" | "ENDED"
  status    String    @default("ACTIVE")
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  tasks Task[]

  @@index([status])
}

/// Append-only system/security event log surfaced in the Activity view.
model SystemEvent {
  id        String   @id @default(cuid())
  /// "INFO" | "WARNING" | "ERROR" | "SECURITY"
  type      String   @default("INFO")
  /// "APP" | "DATABASE" | "IPC" | "TASK" | "AGENT"
  source    String   @default("APP")
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type])
}
